#!name=TrashCleaner 开屏广告净化
#!desc=去除国行 App 开屏广告（17 个 App + 通用广告 SDK，清单见 dist/STATUS.md）
#!author=ios-trashcleaner
#!version=0.1.0
#!category=TrashCleaner

[Rule]
# 通用广告 SDK · 腾讯广点通/优量汇（mi/v/v2mi/c3/v3 等，含 QUIC）
DOMAIN-SUFFIX,gdt.qq.com,REJECT
# 通用广告 SDK · 字节穿山甲 广告请求
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
# 通用广告 SDK · 字节穿山甲 广告请求（备用域）
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
# 通用广告 SDK · 字节穿山甲 日志上报
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
# 通用广告 SDK · 字节穿山甲 素材 CDN
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
# 通用广告 SDK · 京东 DSP 广告
DOMAIN,dsp-x.jd.com,REJECT
# 豆瓣 · 豆瓣自有广告投放服务
DOMAIN,erebor.douban.com,REJECT
# 夸克 · UC/夸克「汇川」广告平台
DOMAIN-SUFFIX,huichuan.sm.cn,REJECT
# 微博 · 广告素材 CDN
DOMAIN,adimg.uve.weibo.com,REJECT

[URL Rewrite]
# 金十数据 · 金十自有广告接口（来源：blackmatrix7/ios_rule_script 去广告规则集）
^https:\/\/jad-api\.jin10\.com\/ad - reject

[Map Local]
# 百度网盘 · 广告交易接口（含开屏）
^https:\/\/pan\.baidu\.com\/rest\/2\.0\/pcs\/adx data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 百度网盘 · 活动弹窗入口
^https:\/\/pan\.baidu\.com\/act\/api\/activityentry data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 豆瓣 · App 开屏配置
^https:\/\/frodo\.douban\.com\/api\/v2\/splash data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 豆瓣 · 旧版开屏广告接口
^https:\/\/api\.douban\.com\/v2\/app_ads\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 虎扑 · 广告接口（含开屏）；把握较低，需抓包确认
^https:\/\/(games\.mobileapi|goblin)\.hupu\.com\/.+\/interfaceAd data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 美团 · 广告联盟 / 展位 / 麦达斯广告素材
^https?:\/\/img\.meituan\.net\/(adunion|display|midas)\/ data-type=tiny-gif status-code=200
# 美团 · 玲珑开屏素材（图片/视频）
^https?:\/\/(s3plus|flowplus)\.meituan\.net\/v\d\/\w+\/linglong\/\w+\.(gif|jpg|png|mp4) data-type=tiny-gif status-code=200
# 网易云音乐 · eapi 响应体加密，无法改写，只能整体拒绝广告接口
^https?:\/\/interface\d?\.music\.163\.com\/eapi\/ad\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 起点读书 · 开屏配置 / iOS 广告位
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d\/client\/(getsplashscreen|iosad) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 去哪儿旅行 · 开屏广告（pitcher 网关按 qrt 参数区分业务）
^https:\/\/client\.qunar\.com\/pitcher-proxy\?qrt=p_splashAd data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 淘宝 · 首页开屏配置 / 开屏视频
^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(wireless\.home\.splash\.awesome\.get|cloudvideo\.video\.query) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 淘宝 · 通用广告位
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 微博 · 启动时实时开屏广告
^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 闲鱼 · 名字里带 splash 的闲鱼 mtop 接口
^https:\/\/(acs\.m\.taobao|(g-)?acs\.m\.goofish)\.com\/gw\/mtop\.(taobao\.)?idle\.[\w.]*splash data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 知乎 · 开屏广告下发接口（含实时竞价版本）
^https:\/\/api\.zhihu\.com\/commercial_api\/(real_time_)?launch_v2 data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# 高德地图 · 阿里妈妈开屏：清空素材并把投放时间改到 2090 年
tc-amap-1 = type=http-response,pattern=^https:\/\/m5(-zb)?\.amap\.com\/ws\/valueadded\/alimama\/splash_screen,requires-body=1,max-size=0,timeout=10,script-path=https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/amap-splash.js
# 哔哩哔哩 · 清空开屏素材列表，并把拉取间隔拉到一年
tc-bilibili-1 = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(brand\/list|event\/list2|list|show),requires-body=1,max-size=0,timeout=10,script-path=https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/bilibili-splash.js
# 京东 · 启动配置接口：清空开屏图片，日展示次数置 0
tc-jd-1 = type=http-response,pattern=^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=start\b,requires-body=1,max-size=0,timeout=10,script-path=https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/jd-splash.js
# 微博 · 预加载开屏广告；响应为 JSON 后接 "OK"，脚本会保留后缀
tc-weibo-1 = type=http-response,pattern=^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php,requires-body=1,max-size=0,timeout=10,script-path=https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/weibo-splash.js
# 微博 · 拉取缓存开屏广告
tc-weibo-2 = type=http-response,pattern=^https:\/\/wbapp\.uve\.weibo\.com\/wbapplua\/wbpullad\.lua,requires-body=1,max-size=0,timeout=10,script-path=https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/weibo-splash.js
# 小红书 · 把所有开屏素材的投放时间改到 2090 年，已缓存的素材也不会展示
tc-xiaohongshu-1 = type=http-response,pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/system_service\/splash_config,requires-body=1,max-size=0,timeout=10,script-path=https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/xiaohongshu-splash.js

[MITM]
hostname = %APPEND% m5.amap.com, m5-zb.amap.com, pan.baidu.com, app.bilibili.com, frodo.douban.com, api.douban.com, games.mobileapi.hupu.com, goblin.hupu.com, api.m.jd.com, jad-api.jin10.com, img.meituan.net, s3plus.meituan.net, flowplus.meituan.net, interface*.music.163.com, magev6.if.qidian.com, client.qunar.com, guide-acs.m.taobao.com, acs.m.taobao.com, bootrealtime.uve.weibo.com, sdkapp.uve.weibo.com, wbapp.uve.weibo.com, acs.m.goofish.com, g-acs.m.goofish.com, edith.xiaohongshu.com, api.zhihu.com
