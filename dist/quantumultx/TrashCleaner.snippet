#!name=TrashCleaner 开屏广告净化
#!desc=去除国行 App 开屏广告（17 个 App，清单见 dist/STATUS.md）
#!author=ios-trashcleaner
#!version=0.1.0

hostname = m5.amap.com, m5-zb.amap.com, pan.baidu.com, app.bilibili.com, frodo.douban.com, api.douban.com, games.mobileapi.hupu.com, goblin.hupu.com, api.m.jd.com, jad-api.jin10.com, img.meituan.net, s3plus.meituan.net, flowplus.meituan.net, interface*.music.163.com, magev6.if.qidian.com, client.qunar.com, guide-acs.m.taobao.com, acs.m.taobao.com, bootrealtime.uve.weibo.com, sdkapp.uve.weibo.com, wbapp.uve.weibo.com, acs.m.goofish.com, g-acs.m.goofish.com, edith.xiaohongshu.com, api.zhihu.com

# 百度网盘 · 广告交易接口（含开屏）
^https:\/\/pan\.baidu\.com\/rest\/2\.0\/pcs\/adx url reject-dict
# 百度网盘 · 活动弹窗入口
^https:\/\/pan\.baidu\.com\/act\/api\/activityentry url reject-dict
# 豆瓣 · App 开屏配置
^https:\/\/frodo\.douban\.com\/api\/v2\/splash url reject-dict
# 豆瓣 · 旧版开屏广告接口
^https:\/\/api\.douban\.com\/v2\/app_ads\/ url reject-dict
# 虎扑 · 广告接口（含开屏）；把握较低，需抓包确认
^https:\/\/(games\.mobileapi|goblin)\.hupu\.com\/.+\/interfaceAd url reject-dict
# 金十数据 · 金十自有广告接口（来源：blackmatrix7/ios_rule_script 去广告规则集）
^https:\/\/jad-api\.jin10\.com\/ad url reject
# 美团 · 广告联盟 / 展位 / 麦达斯广告素材
^https?:\/\/img\.meituan\.net\/(adunion|display|midas)\/ url reject-img
# 美团 · 玲珑开屏素材（图片/视频）
^https?:\/\/(s3plus|flowplus)\.meituan\.net\/v\d\/\w+\/linglong\/\w+\.(gif|jpg|png|mp4) url reject-img
# 网易云音乐 · eapi 响应体加密，无法改写，只能整体拒绝广告接口
^https?:\/\/interface\d?\.music\.163\.com\/eapi\/ad\/ url reject-dict
# 起点读书 · 开屏配置 / iOS 广告位
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d\/client\/(getsplashscreen|iosad) url reject-dict
# 去哪儿旅行 · 开屏广告（pitcher 网关按 qrt 参数区分业务）
^https:\/\/client\.qunar\.com\/pitcher-proxy\?qrt=p_splashAd url reject-dict
# 淘宝 · 首页开屏配置 / 开屏视频
^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(wireless\.home\.splash\.awesome\.get|cloudvideo\.video\.query) url reject-dict
# 淘宝 · 通用广告位
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv url reject-dict
# 微博 · 启动时实时开屏广告
^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime url reject-dict
# 闲鱼 · 名字里带 splash 的闲鱼 mtop 接口
^https:\/\/(acs\.m\.taobao|(g-)?acs\.m\.goofish)\.com\/gw\/mtop\.(taobao\.)?idle\.[\w.]*splash url reject-dict
# 知乎 · 开屏广告下发接口（含实时竞价版本）
^https:\/\/api\.zhihu\.com\/commercial_api\/(real_time_)?launch_v2 url reject-dict
# 高德地图 · 阿里妈妈开屏：清空素材并把投放时间改到 2090 年
^https:\/\/m5(-zb)?\.amap\.com\/ws\/valueadded\/alimama\/splash_screen url script-response-body https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/amap-splash.js
# 哔哩哔哩 · 清空开屏素材列表，并把拉取间隔拉到一年
^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(brand\/list|event\/list2|list|show) url script-response-body https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/bilibili-splash.js
# 京东 · 启动配置接口：清空开屏图片，日展示次数置 0
^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=start\b url script-response-body https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/jd-splash.js
# 微博 · 预加载开屏广告；响应为 JSON 后接 "OK"，脚本会保留后缀
^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php url script-response-body https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/weibo-splash.js
# 微博 · 拉取缓存开屏广告
^https:\/\/wbapp\.uve\.weibo\.com\/wbapplua\/wbpullad\.lua url script-response-body https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/weibo-splash.js
# 小红书 · 把所有开屏素材的投放时间改到 2090 年，已缓存的素材也不会展示
^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/system_service\/splash_config url script-response-body https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/xiaohongshu-splash.js
