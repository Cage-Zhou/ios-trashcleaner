name: 'TrashCleaner 开屏广告净化'
desc: '去除国行 App 开屏广告（17 个 App + 通用广告 SDK，清单见 dist/STATUS.md）'

rules:
  # 通用广告 SDK · 腾讯广点通/优量汇（mi/v/v2mi/c3/v3 等，含 QUIC）
  - 'DOMAIN-SUFFIX,gdt.qq.com,REJECT'
  # 通用广告 SDK · 腾讯优量汇 新版 SDK 广告请求
  - 'DOMAIN,sdk.e.qq.com,REJECT'
  # 通用广告 SDK · 腾讯优量汇 新版 SDK（QUIC/UDP）
  - 'DOMAIN,sdkquic.e.qq.com,REJECT'
  # 通用广告 SDK · 腾讯广告素材 CDN（adsmind.ugdtimg.com 即开屏图片）
  - 'DOMAIN-SUFFIX,ugdtimg.com,REJECT'
  # 通用广告 SDK · 腾讯广告素材 CDN（旧域名）
  - 'DOMAIN-SUFFIX,gdtimg.com,REJECT'
  # 通用广告 SDK · 字节穿山甲 广告请求
  - 'DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT'
  # 通用广告 SDK · 字节穿山甲 广告请求（备用域）
  - 'DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT'
  # 通用广告 SDK · 字节穿山甲 日志上报
  - 'DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT'
  # 通用广告 SDK · 字节穿山甲 素材 CDN
  - 'DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT'
  # 通用广告 SDK · 京东 DSP 广告
  - 'DOMAIN,dsp-x.jd.com,REJECT'
  # 豆瓣 · 豆瓣自有广告投放服务
  - 'DOMAIN,erebor.douban.com,REJECT'
  # 夸克 · UC/夸克「汇川」广告平台
  - 'DOMAIN-SUFFIX,huichuan.sm.cn,REJECT'
  # 微博 · 广告素材 CDN
  - 'DOMAIN,adimg.uve.weibo.com,REJECT'

http:
  mitm:
    - 'm5.amap.com'
    - 'm5-zb.amap.com'
    - 'pan.baidu.com'
    - 'app.bilibili.com'
    - 'frodo.douban.com'
    - 'api.douban.com'
    - 'games.mobileapi.hupu.com'
    - 'goblin.hupu.com'
    - 'api.m.jd.com'
    - 'jad-api.jin10.com'
    - 'img.meituan.net'
    - 's3plus.meituan.net'
    - 'flowplus.meituan.net'
    - 'interface*.music.163.com'
    - 'magev6.if.qidian.com'
    - 'client.qunar.com'
    - 'guide-acs.m.taobao.com'
    - 'acs.m.taobao.com'
    - 'bootrealtime.uve.weibo.com'
    - 'sdkapp.uve.weibo.com'
    - 'wbapp.uve.weibo.com'
    - 'acs.m.goofish.com'
    - 'g-acs.m.goofish.com'
    - 'edith.xiaohongshu.com'
    - 'api.zhihu.com'
  url-rewrite:
    # 百度网盘 · 广告交易接口（含开屏）
    - '^https:\/\/pan\.baidu\.com\/rest\/2\.0\/pcs\/adx - reject-dict'
    # 百度网盘 · 活动弹窗入口
    - '^https:\/\/pan\.baidu\.com\/act\/api\/activityentry - reject-dict'
    # 豆瓣 · App 开屏配置
    - '^https:\/\/frodo\.douban\.com\/api\/v2\/splash - reject-dict'
    # 豆瓣 · 旧版开屏广告接口
    - '^https:\/\/api\.douban\.com\/v2\/app_ads\/ - reject-dict'
    # 虎扑 · 广告接口（含开屏）；把握较低，需抓包确认
    - '^https:\/\/(games\.mobileapi|goblin)\.hupu\.com\/.+\/interfaceAd - reject-dict'
    # 金十数据 · 金十自有广告接口（来源：blackmatrix7/ios_rule_script）；返回空 JSON 而非断连，避免 App 回退到本地缓存的开屏
    - '^https:\/\/jad-api\.jin10\.com\/ad - reject-dict'
    # 美团 · 广告联盟 / 展位 / 麦达斯广告素材
    - '^https?:\/\/img\.meituan\.net\/(adunion|display|midas)\/ - reject-img'
    # 美团 · 玲珑开屏素材（图片/视频）
    - '^https?:\/\/(s3plus|flowplus)\.meituan\.net\/v\d\/\w+\/linglong\/\w+\.(gif|jpg|png|mp4) - reject-img'
    # 网易云音乐 · eapi 响应体加密，无法改写，只能整体拒绝广告接口
    - '^https?:\/\/interface\d?\.music\.163\.com\/eapi\/ad\/ - reject-dict'
    # 起点读书 · 开屏配置 / iOS 广告位
    - '^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v\d\/client\/(getsplashscreen|iosad) - reject-dict'
    # 去哪儿旅行 · 开屏广告（pitcher 网关按 qrt 参数区分业务）
    - '^https:\/\/client\.qunar\.com\/pitcher-proxy\?qrt=p_splashAd - reject-dict'
    # 淘宝 · 首页开屏配置 / 开屏视频
    - '^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(wireless\.home\.splash\.awesome\.get|cloudvideo\.video\.query) - reject-dict'
    # 淘宝 · 通用广告位
    - '^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv - reject-dict'
    # 微博 · 启动时实时开屏广告
    - '^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime - reject-dict'
    # 闲鱼 · 名字里带 splash 的闲鱼 mtop 接口
    - '^https:\/\/(acs\.m\.taobao|(g-)?acs\.m\.goofish)\.com\/gw\/mtop\.(taobao\.)?idle\.[\w.]*splash - reject-dict'
    # 知乎 · 开屏广告下发接口（含实时竞价版本）
    - '^https:\/\/api\.zhihu\.com\/commercial_api\/(real_time_)?launch_v2 - reject-dict'
  script:
    # 高德地图 · 阿里妈妈开屏：清空素材并把投放时间改到 2090 年
    - match: '^https:\/\/m5(-zb)?\.amap\.com\/ws\/valueadded\/alimama\/splash_screen'
      name: 'amap-splash'
      type: response
      require-body: true
      timeout: 10
    # 哔哩哔哩 · 清空开屏素材列表，并把拉取间隔拉到一年
    - match: '^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(brand\/list|event\/list2|list|show)'
      name: 'bilibili-splash'
      type: response
      require-body: true
      timeout: 10
    # 京东 · 启动配置接口：清空开屏图片，日展示次数置 0
    - match: '^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=start\b'
      name: 'jd-splash'
      type: response
      require-body: true
      timeout: 10
    # 微博 · 预加载开屏广告；响应为 JSON 后接 "OK"，脚本会保留后缀
    - match: '^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php'
      name: 'weibo-splash'
      type: response
      require-body: true
      timeout: 10
    # 微博 · 拉取缓存开屏广告
    - match: '^https:\/\/wbapp\.uve\.weibo\.com\/wbapplua\/wbpullad\.lua'
      name: 'weibo-splash'
      type: response
      require-body: true
      timeout: 10
    # 小红书 · 把所有开屏素材的投放时间改到 2090 年，已缓存的素材也不会展示
    - match: '^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/system_service\/splash_config'
      name: 'xiaohongshu-splash'
      type: response
      require-body: true
      timeout: 10

script-providers:
  'amap-splash':
    url: 'https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/amap-splash.js'
    interval: 86400
  'bilibili-splash':
    url: 'https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/bilibili-splash.js'
    interval: 86400
  'jd-splash':
    url: 'https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/jd-splash.js'
    interval: 86400
  'weibo-splash':
    url: 'https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/weibo-splash.js'
    interval: 86400
  'xiaohongshu-splash':
    url: 'https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/xiaohongshu-splash.js'
    interval: 86400
