#!name=TrashCleaner 开屏广告净化
#!desc=去除国行 App 开屏广告（淘宝/京东/美团/高德/微博/知乎/B站/小红书/网易云/百度网盘）
#!author=ios-trashcleaner
#!version=0.1.0

[Rule]
# 微博 · 广告素材 CDN
DOMAIN,adimg.uve.weibo.com,REJECT

[Rewrite]
# 百度网盘 · 广告交易接口（含开屏）
^https:\/\/pan\.baidu\.com\/rest\/2\.0\/pcs\/adx reject-dict
# 百度网盘 · 活动弹窗入口
^https:\/\/pan\.baidu\.com\/act\/api\/activityentry reject-dict
# 美团 · 广告联盟 / 展位 / 麦达斯广告素材
^https?:\/\/img\.meituan\.net\/(adunion|display|midas)\/ reject-img
# 美团 · 玲珑开屏素材（图片/视频）
^https?:\/\/(s3plus|flowplus)\.meituan\.net\/v\d\/\w+\/linglong\/\w+\.(gif|jpg|png|mp4) reject-img
# 网易云音乐 · eapi 响应体加密，无法改写，只能整体拒绝广告接口
^https?:\/\/interface\d?\.music\.163\.com\/eapi\/ad\/ reject-dict
# 淘宝 · 首页开屏配置 / 开屏视频
^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(wireless\.home\.splash\.awesome\.get|cloudvideo\.video\.query) reject-dict
# 淘宝 · 通用广告位
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv reject-dict
# 微博 · 启动时实时开屏广告
^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime reject-dict
# 知乎 · 开屏广告下发接口（含实时竞价版本）
^https:\/\/api\.zhihu\.com\/commercial_api\/(real_time_)?launch_v2 reject-dict

[Script]
# 高德地图 · 阿里妈妈开屏：清空素材并把投放时间改到 2090 年
http-response ^https:\/\/m5(-zb)?\.amap\.com\/ws\/valueadded\/alimama\/splash_screen script-path=https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/amap-splash.js, requires-body=true, timeout=10, tag=tc-amap-1
# 哔哩哔哩 · 清空开屏素材列表，并把拉取间隔拉到一年
http-response ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(brand\/list|event\/list2|list|show) script-path=https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/bilibili-splash.js, requires-body=true, timeout=10, tag=tc-bilibili-1
# 京东 · 启动配置接口：清空开屏图片，日展示次数置 0
http-response ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=start\b script-path=https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/jd-splash.js, requires-body=true, timeout=10, tag=tc-jd-1
# 微博 · 预加载开屏广告；响应为 JSON 后接 "OK"，脚本会保留后缀
http-response ^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php script-path=https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/weibo-splash.js, requires-body=true, timeout=10, tag=tc-weibo-1
# 微博 · 拉取缓存开屏广告
http-response ^https:\/\/wbapp\.uve\.weibo\.com\/wbapplua\/wbpullad\.lua script-path=https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/weibo-splash.js, requires-body=true, timeout=10, tag=tc-weibo-2
# 小红书 · 把所有开屏素材的投放时间改到 2090 年，已缓存的素材也不会展示
http-response ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d\/system_service\/splash_config script-path=https://cdn.jsdelivr.net/gh/Cage-Zhou/ios-trashcleaner@main/dist/scripts/xiaohongshu-splash.js, requires-body=true, timeout=10, tag=tc-xiaohongshu-1

[MITM]
hostname = m5.amap.com, m5-zb.amap.com, pan.baidu.com, app.bilibili.com, api.m.jd.com, img.meituan.net, s3plus.meituan.net, flowplus.meituan.net, interface*.music.163.com, guide-acs.m.taobao.com, acs.m.taobao.com, bootrealtime.uve.weibo.com, sdkapp.uve.weibo.com, wbapp.uve.weibo.com, edith.xiaohongshu.com, api.zhihu.com
